# Backend API Base URL
# For production deployment (e.g. on Vercel), set this to your Render backend:
 VITE_API_BASE_URL=https://pegpo-production.onrender.com/api





# For local development (when backend runs on http://localhost:5000),
# leave empty or set to /api so Vite proxies calls to localhost:5000:
# VITE_API_BASE_URL=/api
