# Backend API Base URL
# For production deployment (e.g. on Vercel), set this to your Render backend:
VITE_API_URL=https://pegpo-production.onrender.com
VITE_API_BASE_URL=https://pegpo-production.onrender.com/api
# Local development fallback:
# VITE_API_URL=http://localhost:5000
# VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket Classroom Signalling URL
# For production deployment, use wss:// with your Render domain:
VITE_WS_URL=wss://pegpo-production.onrender.com
# Local development fallback:
# VITE_WS_URL=ws://localhost:5000

# Production TURN / STUN Relay Servers for cross-device & cross-network (Wi-Fi <-> Cellular) NAT traversal
# Comma-separated list of TURN servers (e.g. from Metered, Twilio, Cloudflare Calls, or Coturn)
VITE_TURN_URL=turn:standard.relay.metered.ca:80,turns:standard.relay.metered.ca:443
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential

# Google OAuth Client ID for Google Identity Services (Sign In & Sign Up with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Enable Mock Google Authentication for testing (set to true in dev/testing, false or omit in production)
VITE_ENABLE_MOCK_GOOGLE_AUTH=true
