# Backend API Base URL
# For production deployment (e.g. on Vercel), set this to your Render backend:
VITE_API_BASE_URL=https://pegpo-production.onrender.com/api
#VITE_API_BASE_URL=http://localhost:5000

# Google OAuth Client ID for Google Identity Services (Sign In & Sign Up with Google)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Enable Mock Google Authentication for testing (set to true in dev/testing, false or omit in production)
VITE_ENABLE_MOCK_GOOGLE_AUTH=true
# For local development (when backend runs on http://localhost:5000),
# leave empty or set to /api so Vite proxies calls to localhost:5000:
# VITE_API_BASE_URL=/api
